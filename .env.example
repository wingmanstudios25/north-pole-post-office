# Set these in Vercel → Project → Settings → Environment Variables. Never commit real keys.
NEXT_PUBLIC_SITE_URL=https://your-domain.co.uk
STRIPE_SECRET_KEY=sk_live_or_sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...            # optional: only needed for the order email
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=...                    # the Father Christmas voice
BLOB_READ_WRITE_TOKEN=...                  # added automatically when you create a Vercel Blob store
BREVO_API_KEY=...                          # optional: sends the "your letter is ready" email
EMAIL_FROM=post@your-domain.co.uk          # optional, used with Brevo
CRON_SECRET=any-long-random-string
NEXT_PUBLIC_POV_VIDEO=                     # optional: URL of the Santa's-eye background loop
